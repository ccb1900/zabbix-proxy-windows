+/* SYNC WITH PHP! */
+static const char	*zbx_snmpv3_auth_protocol_name(unsigned char authprotocol)
+{
+	switch (authprotocol)
+	{
+		case 0: return "MD5";
+		case 1: return "SHA1";
+		case 2: return "SHA224";
+		case 3: return "SHA256";
+		case 4: return "SHA384";
+		case 5: return "SHA512";
+		default: return "unknown";
+	}
+}
+
+static const char	*zbx_snmpv3_priv_protocol_name(unsigned char privprotocol)
+{
+	switch (privprotocol)
+	{
+		case 0: return "DES";
+		case 1: return "AES128";
+		case 2: return "AES192";
+		case 3: return "AES256";
+		case 4: return "AES192C";
+		case 5: return "AES256C";
+		default: return "unknown";
+	}
+}
+
+#ifdef HAVE_NETSNMP_STRONG_AUTH
+#	define ZBX_SNMPV3_STRONG_AUTH_HINT ""
+#else
+#	define ZBX_SNMPV3_STRONG_AUTH_HINT " (SHA-2 auth support is not compiled in: HAVE_NETSNMP_STRONG_AUTH undefined)"
+#endif
+
+#ifdef HAVE_NETSNMP_STRONG_PRIV
+#	define ZBX_SNMPV3_STRONG_PRIV_HINT ""
+#else
+#	define ZBX_SNMPV3_STRONG_PRIV_HINT " (AES192/256 support is not compiled in: HAVE_NETSNMP_STRONG_PRIV undefined)"
+#endif
+
 static int	zbx_snmpv3_set_auth_protocol(unsigned char snmpv3_authprotocol, struct snmp_session *session)
 {
+	static int	strong_auth_reported = 0;
+
+	if (0 == strong_auth_reported)
+	{
+		strong_auth_reported = 1;
+#ifdef HAVE_NETSNMP_STRONG_AUTH
+		zabbix_log(LOG_LEVEL_DEBUG, "SNMPv3 strong SHA-2 auth protocols are compiled in");
+#else
+		zabbix_log(LOG_LEVEL_WARNING, "SNMPv3 strong SHA-2 auth protocols are NOT compiled in"
+				" (HAVE_NETSNMP_STRONG_AUTH undefined); auth protocols 2-5 will be rejected");
+#endif
+	}
+
+	zabbix_log(LOG_LEVEL_DEBUG, "SNMPv3 auth protocol: %u (%s)", (unsigned int)snmpv3_authprotocol,
+			zbx_snmpv3_auth_protocol_name(snmpv3_authprotocol));
+

diff --git a/create/bin/gen_schema.pl b/create/bin/gen_schema.pl
index e180c8b610c5163530151830ab09889ed3cb6027..ff4805d910e1fd934bdb95774185f257da1100e7 100755
--- a/create/bin/gen_schema.pl
+++ b/create/bin/gen_schema.pl
@@ -931,7 +931,9 @@ sub process()
 	foreach my $line (@lines)
 	{
 		$line =~ tr/\t//d;
-		chop($line);
+		# chop() would leave the carriage return of a CRLF checkout
+		# attached to the last field of every line
+		$line =~ s/[\r\n]+$//;
 
 		my ($type, $opts) = split(/\|/, $line, 2);
 

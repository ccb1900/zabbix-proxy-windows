Build: hook the proxy into the MSVC/nmake build

Shared makefile fragments learn about the proxy target and its extra
libraries; gen_schema.pl tolerates a CRLF checkout.

diff --git a/build/win32/project/Makefile b/build/win32/project/Makefile
index ce29e81cf390922e11049bec0fcea5c277aaf3bc..6e8f6739deec5a5c4e30c87ff32b8c000ab4d2d4 100644
--- a/build/win32/project/Makefile
+++ b/build/win32/project/Makefile
@@ -16,6 +16,9 @@ sender_dll:
 get:
 	nmake /f Makefile_get
 
+proxy:
+	nmake /f Makefile_proxy
+
 clean: agent_clean sender_clean sender_dll_clean get_clean
 
 agent_clean:
@@ -29,3 +32,6 @@ sender_dll_clean:
 
 get_clean:
 	nmake /f Makefile_get clean
+
+proxy_clean:
+	nmake /f Makefile_proxy clean
